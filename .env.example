# Canonical origin for metadata, the sitemap, and robots.
# Keep localhost for local development. Production fallback is https://appointhive.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search Console / Bing HTML verification (optional; Google token also in DNS TXT).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Contact form. Messages go to CONTACT_TO over SMTP.
CONTACT_TO=hello@appointhive.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AppointHive <hello@appointhive.com>"
